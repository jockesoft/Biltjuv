{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Quartz.Core.QuartzSchedulerThread": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Mail": {
    "FromAddress": "no-reply@biltjuv.local",
    "FromDisplayName": "Biltjuv",
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "PickupDirectory": "",
    "BatchSize": 20,
    "MaxSendAttempts": 5
  },
  "//Mail": "Host/Username/Password/FromAddress come from user-secrets (dev) or Mail__* env vars (prod), never here. In Development, mail is written to Biltjuv.Web/mail-pickup as .eml files regardless of these settings.",

  "Login": {
    "TokenLifetimeMinutes": 15,
    "ResendCooldownSeconds": 120,
    "InvalidatePreviousTokens": true,
    "AllowedEmails": [],
    "MaxRequestsPerEmailPerDay": 5,
    "MaxSignInEmailsPerHourSiteWide": 100
  },
  "//Login": "AllowedEmails is the registration allowlist; empty = open. Set per env via Login__AllowedEmails__0, __1, ... .",

  "Steal": {
    "CooldownSeconds": 30,
    "SuccessChancePercent": 70,
    "MinMoneyReward": 50,
    "MaxMoneyReward": 150,
    "RespectReward": 1,
    "MinHealthLossOnBust": 5,
    "MaxHealthLossOnBust": 15
  },

  "HealthRegen": {
    "IntervalMinutes": 5,
    "HealthPerTick": 10
  },
  "//HealthRegen": "IntervalMinutes is overridden to 2 in appsettings.Development.json.",

  "Level": {
    "RespectPerLevel": 10
  },

  "Warehouses": {
    "FilePath": "Config/warehouses.json",
    "CacheTtlHours": 24
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=biltjuv_db;Username=postgres;Password=devpassword",
    "RedisConnection": "localhost:6379"
  },
  "//ConnectionStrings": "RedisConnection can be overridden via the REDIS_CONNECTION env var (e.g. redis:6379 in prod).",

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Quartz.Core.QuartzSchedulerThread": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "flushToDiskInterval": "00:00:05"
        }
      }
    ]
  }
}
