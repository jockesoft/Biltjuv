@page
@model VerifyModel
@{
    ViewData["Title"] = "Sign-in link";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-8 col-lg-5">
        <div class="bj-panel mt-4">
            <h1 class="h3 mb-3">This sign-in link didn't work</h1>
            <p class="text-muted">
                It may have expired, already been used, or been copied incompletely.
                Request a fresh one and try again.
            </p>
            <a class="btn btn-primary" asp-page="/Account/Login">Back to sign in</a>
        </div>
    </div>
</div>
