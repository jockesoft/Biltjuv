@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-8 col-lg-5">
        <div class="bj-panel mt-4">
            <div class="bj-hero-tagline mb-2">Råna &middot; Stjäl &middot; Härska</div>
            <h1 class="h3 mb-3">Sign in to Biltjuv</h1>

            @if (Model.LinkSent)
            {
                <div class="alert alert-success" role="alert">
                    If <strong>@Model.Email</strong> has an account, a sign-in link is on its way.
                    Open the email and follow the link to get in. It expires shortly and only works once.
                </div>
                <a class="btn btn-link px-0" asp-page="/Account/Login">Use a different email</a>
            }
            else
            {
                <p class="text-muted">
                    No account yet? None needed — enter your email below and we'll send a secure
                    sign-in link. First time in, an account is created for you automatically.
                    No password to remember, nothing to steal from you but a login link.
                </p>

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="FormRenderedAtUtc" />

                    @* Honeypot: off-screen, not announced to AT, skipped by keyboard.
                       Real users never fill it; bots often do. *@
                    <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
                        <label for="Website">Website</label>
                        <input asp-for="Website" autocomplete="off" tabindex="-1" />
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" autofocus
                               placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send sign-in link</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
